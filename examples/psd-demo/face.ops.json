[
  { "op": "addParameter", "id": "AngleX", "min": -30, "max": 30, "default": 0 },
  { "op": "addParameter", "id": "AngleY", "min": -30, "max": 30, "default": 0 },
  { "op": "addParameter", "id": "AngleZ", "min": -30, "max": 30, "default": 0 },
  { "op": "addParameter", "id": "EyeOpen", "min": 0, "max": 1, "default": 1 },
  { "op": "addParameter", "id": "MouthOpen", "min": 0, "max": 1, "default": 0 },
  { "op": "addParameter", "id": "BodyAngleZ", "min": -10, "max": 10, "default": 0 },

  { "op": "addWarp", "id": "face", "targets": ["head", "hair", "eye_L", "eye_R", "mouth"], "cols": 4, "rows": 4, "padding": 0.05 },
  { "op": "addWarp", "id": "features", "targets": ["eye_L", "eye_R", "mouth"], "cols": 2, "rows": 2, "padding": 0.3 },

  { "op": "setParamWarp", "parameter": "AngleX", "warp": "face", "keys": [
    { "at": -30, "preset": "turnX", "amount": -0.12 }, { "at": 0, "preset": "turnX", "amount": 0 }, { "at": 30, "preset": "turnX", "amount": 0.12 }] },
  { "op": "setParamWarp", "parameter": "AngleX", "warp": "features", "keys": [
    { "at": -30, "preset": "translateX", "amount": -9 }, { "at": 0, "preset": "translateX", "amount": 0 }, { "at": 30, "preset": "translateX", "amount": 9 }] },
  { "op": "setParamWarp", "parameter": "AngleY", "warp": "face", "keys": [
    { "at": -30, "preset": "turnY", "amount": -0.1 }, { "at": 0, "preset": "turnY", "amount": 0 }, { "at": 30, "preset": "turnY", "amount": 0.1 }] },
  { "op": "setParamWarp", "parameter": "AngleY", "warp": "features", "keys": [
    { "at": -30, "preset": "translateY", "amount": -7 }, { "at": 0, "preset": "translateY", "amount": 0 }, { "at": 30, "preset": "translateY", "amount": 7 }] },
  { "op": "setParamBoneKeys", "parameter": "AngleZ", "bone": "head", "channel": "rotate", "keys": [{ "at": -30, "v": -15 }, { "at": 30, "v": 15 }] },

  { "op": "setParamShape", "parameter": "EyeOpen", "attachment": "eye_L", "keys": [
    { "at": 0, "transform": { "scale": [1.1, 0.12] } }, { "at": 1, "offsets": [] }] },
  { "op": "setParamShape", "parameter": "EyeOpen", "attachment": "eye_R", "keys": [
    { "at": 0, "transform": { "scale": [1.1, 0.12] } }, { "at": 1, "offsets": [] }] },
  { "op": "setParamShape", "parameter": "MouthOpen", "attachment": "mouth", "keys": [
    { "at": 0, "offsets": [] }, { "at": 1, "transform": { "scale": [1.1, 2.4] } }] },
  { "op": "setParamBoneKeys", "parameter": "BodyAngleZ", "bone": "torso", "channel": "rotate", "keys": [{ "at": -10, "v": -7 }, { "at": 10, "v": 7 }] },

  { "op": "setAnimation", "name": "talk", "duration": 4, "loop": true },
  { "op": "setParamTrack", "animation": "talk", "parameter": "AngleX", "keys": [
    { "t": 0, "v": 0, "ease": "easeInOut" }, { "t": 1, "v": 18, "ease": "easeInOut" }, { "t": 2.2, "v": -14, "ease": "easeInOut" }, { "t": 4, "v": 0 }] },
  { "op": "setParamTrack", "animation": "talk", "parameter": "AngleY", "keys": [
    { "t": 0, "v": 0, "ease": "easeInOut" }, { "t": 1.5, "v": 10, "ease": "easeInOut" }, { "t": 3, "v": -8, "ease": "easeInOut" }, { "t": 4, "v": 0 }] },
  { "op": "setParamTrack", "animation": "talk", "parameter": "BodyAngleZ", "keys": [
    { "t": 0, "v": 0, "ease": "easeInOut" }, { "t": 2, "v": 5, "ease": "easeInOut" }, { "t": 4, "v": 0 }] },
  { "op": "setParamTrack", "animation": "talk", "parameter": "EyeOpen", "keys": [
    { "t": 0, "v": 1 }, { "t": 1.7, "v": 1 }, { "t": 1.8, "v": 0 }, { "t": 1.9, "v": 1 }, { "t": 4, "v": 1 }] },
  { "op": "setParamTrack", "animation": "talk", "parameter": "MouthOpen", "keys": [
    { "t": 0, "v": 0 }, { "t": 0.25, "v": 0.8 }, { "t": 0.45, "v": 0.2 }, { "t": 0.65, "v": 1 }, { "t": 0.9, "v": 0.1 },
    { "t": 1.2, "v": 0.7 }, { "t": 1.5, "v": 0 }, { "t": 2.6, "v": 0 }, { "t": 2.8, "v": 0.9 }, { "t": 3.1, "v": 0.3 },
    { "t": 3.4, "v": 0.8 }, { "t": 3.7, "v": 0 }, { "t": 4, "v": 0 }] }
]
